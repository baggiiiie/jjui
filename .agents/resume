#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.local/bin:$PATH"

command -v go >/dev/null 2>&1 || {
	echo "Go is unavailable; rerun .agents/setup" >&2
	exit 1
}
command -v jj >/dev/null 2>&1 || {
	echo "Jujutsu is unavailable; rerun .agents/setup" >&2
	exit 1
}

echo "jjui tools available: $(go version); $(jj --version)"
